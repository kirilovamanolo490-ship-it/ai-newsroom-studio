+def _valid_youtube_video_url(url: str) -> bool:
+    parsed = urlparse(url)
+    host = (parsed.hostname or "").lower()
+    if host not in {"youtube.com", "www.youtube.com", "m.youtube.com", "youtu.be"}:
+        return False
+    if host == "youtu.be":
+        video_id = parsed.path.strip("/").split("/")[0]
+    else:
+        video_id = parse_qs(parsed.query).get("v", [""])[0]
+    return bool(re.fullmatch(r"[A-Za-z0-9_-]{11}", video_id))
+
+
+async def _wait_publish_confirmation(page: Page, timeout_ms: int = 30000) -> str | None:
+    """Require a confirmed success message and a valid video URL in Studio's share dialog."""
+    deadline = asyncio.get_running_loop().time() + timeout_ms / 1000
+    confirmation_text = ("Video published", "Your video is published", "视频已发布", "视频发布成功")
+    while asyncio.get_running_loop().time() < deadline:
+        try:
+            result_dialog = page.locator("ytcp-video-share-dialog").first
+            if await result_dialog.count():
+                dialog_text = await result_dialog.inner_text()
+                if any(phrase.lower() in dialog_text.lower() for phrase in confirmation_text):
+                    links = result_dialog.locator("a[href]")
+                    for index in range(await links.count()):
+                        href = (await links.nth(index).get_attribute("href") or "").strip()
+                        if _valid_youtube_video_url(href):
+                            return href
+        except Exception:
+            pass
+        await page.wait_for_timeout(500)
+    return None
+
+
+async def _require_upload_complete(page: Page, max_polls: int = 360) -> None:
+    if not await _wait_upload_complete(page, max_polls=max_polls):
+        raise RuntimeError("YouTube upload did not reach a confirmed complete state; publish was not submitted")
+
+
+async def _require_publish_confirmation(page: Page, timeout_ms: int = 30000) -> str:
+    confirmation = await _wait_publish_confirmation(page, timeout_ms=timeout_ms)
+    if confirmation is None:
+        raise RuntimeError("YouTube share dialog did not confirm publication with a valid video URL")
+    return confirmation
+
+
+async def _confirm_from_channel_list(page: Page, title: str, visibility: str = 'public') -> str:
+    """Read the exact new video's Studio row when the share dialog has changed."""
+    current = urlparse(page.url)
+    channel = re.match(r'^/channel/(UC[A-Za-z0-9_-]+)(?:/|$)', current.path)
+    if current.hostname != 'studio.youtube.com' or not channel or visibility != 'public':
+        raise RuntimeError('YouTube submission needs separate channel verification')
+    await page.goto(f'https://studio.youtube.com/channel/{channel.group(1)}/content',
+                    wait_until='domcontentloaded', timeout=60000)
+    row = page.get_by_role('row').filter(has=page.get_by_role('link', name=title, exact=True))
+    await row.first.wait_for(state='visible', timeout=45000)
+    if await row.count() != 1:
+        raise RuntimeError('YouTube title does not identify exactly one video; refusing to infer success')
+    text = await row.inner_text()
+    if not re.search(r'\bPublic\b|公开|公開', text) or not re.search(r'\bPublished\b|已发布|已發佈', text):
+        raise RuntimeError('YouTube video exists but public/published state is not confirmed')
+    href = await row.get_by_role('link', name=title, exact=True).first.get_attribute('href') or ''
+    parsed = urlparse(href)
+    if parsed.netloc and parsed.hostname != 'studio.youtube.com':
+        raise RuntimeError('Unexpected YouTube Studio video link')
+    video = re.fullmatch(r'/video/([A-Za-z0-9_-]{11})/edit/?', parsed.path)
+    if not video:
+        raise RuntimeError('YouTube Studio did not provide a concrete video ID')
+    return f'https://www.youtube.com/watch?v={video.group(1)}'
+
+
+async def _submit_publish_and_confirm(page: Page, title: str | None = None, visibility: str = 'public') -> str:
